{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DividerResult",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "summary": { "type": "string", "maxLength": 1000 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["title", "steps"],
        "properties": {
          "key": { "type": "string", "maxLength": 40 },
          "title": { "type": "string", "maxLength": 300 },
          "task_type": { "type": "string", "maxLength": 60 },
          "end_goal": { "type": "string", "maxLength": 8000 },
          "depends_on": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["role", "goal"],
              "properties": { "role": { "type": "string" }, "goal": { "type": "string", "maxLength": 4000 } }
            }
          }
        }
      }
    }
  }
}
