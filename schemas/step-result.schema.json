{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StepResult",
  "type": "object",
  "required": ["status", "summary", "output"],
  "additionalProperties": true,
  "properties": {
    "v": { "type": "integer" },
    "task_id": { "type": "string" },
    "step": { "type": "integer" },
    "attempt": { "type": "integer" },
    "role": { "type": "string" },
    "status": { "type": "string", "enum": ["done", "failed", "blocked"] },
    "summary": { "type": "string", "maxLength": 1000 },
    "output": { "type": "string", "maxLength": 60000 },
    "handoff": { "type": "string", "maxLength": 20000 },
    "blocked_reason": { "type": "string", "maxLength": 2000 },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["diagram", "file", "markdown", "link"] },
          "title": { "type": "string", "maxLength": 200 },
          "body": { "type": "string", "maxLength": 40000 },
          "path": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "spawn_tasks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["title", "steps"],
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "end_goal": { "type": "string", "maxLength": 8000 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["role", "goal"],
              "properties": { "role": { "type": "string" }, "goal": { "type": "string", "maxLength": 4000 } }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": { "tokens": { "type": "number" }, "tool_calls": { "type": "number" } }
    }
  }
}
