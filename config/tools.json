{
  "servers": [
    {
      "id": "filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp"
      ],
      "note": "Built-in"
    },
    {
      "id": "reddit",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "reddit-mcp-buddy"
      ]
    },
    {
      "id": "gmail",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "gmail-mcp"
      ],
      "note": "Gmail: read, send, labels, drafts (37 tools). Sign in needed.",
      "authStatus": "needed",
      "authHint": "Added, but sign-in needed before it can fetch your Gmail. Click Sign in on its card."
    }
  ],
  "customTools": [
    {
      "id": "set_havells_bulb_state",
      "description": "Turn the living-room Havells smart bulb on or off and set its color and brightness.",
      "method": "POST",
      "url": "https://api.havells.example/v1/devices/living-room/state",
      "headers": {
        "X-Api-Key": "{{params.api_key}}",
        "Content-Type": "application/json"
      },
      "bodyTemplate": "{\"power\":\"{{params.power}}\",\"color\":\"{{params.color}}\",\"brightness\":{{params.brightness}}}",
      "params": {
        "api_key": {
          "description": "Havells API key.",
          "required": true
        },
        "power": {
          "description": "Bulb power state: on or off.",
          "required": true
        },
        "color": {
          "description": "Bulb color value accepted by the Havells API.",
          "required": true
        },
        "brightness": {
          "description": "Bulb brightness value accepted by the Havells API.",
          "required": true
        }
      },
      "timeoutMs": 20000,
      "approvalRequired": true
    }
  ]
}
