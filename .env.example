DISCORD_BOT_TOKEN=put-your-bot-token-here
DISCORD_APPLICATION_ID=1546860691326111865
DISCORD_GUILD_ID=1546862774909669457
# Channel for workflow notifications + always-on listening (right-click channel -> Copy Channel ID with Developer Mode on)
DISCORD_CHANNEL_ID=put-listen-channel-id-here
# Finance briefings target (#finance). Falls back to DISCORD_CHANNEL_ID if empty.
FINANCE_CHANNEL_ID=put-finance-channel-id-here
# Optional: restrict the always-on responder to these channel IDs (comma-separated). Leave empty = respond on mention/DM only.
DISCORD_LISTEN_CHANNELS=
# Owner user id — only this user can approve gated tools. Right-click user -> Copy ID.
DISCORD_OWNER_USER_ID=

# --- Azure OpenAI (one deployment serves all agents by default) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=put-your-azure-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenRouter (optional, configured via npm run setup) ---
# OPENROUTER_API_KEY=put-your-openrouter-key-here

# --- Meta Llama API (optional, configured via npm run setup) ---
# META_API_KEY=put-your-meta-key-here

# Optional per-agent deployment overrides (leave empty to use the default above)
# AZURE_OPENAI_DEPLOYMENT_CODER=
# AZURE_OPENAI_DEPLOYMENT_SUMMARIZER=

# Timezone used for schedule logging (Termux: date -u to verify clock)
TZ=Asia/Kolkata